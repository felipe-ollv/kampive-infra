{
    admin off
    skip_install_trust
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

https://localhost:8443, https://127.0.0.1:8443 {
    tls internal
    handle_path /legal/* {
        root * /srv/legal
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        file_server
    }
    handle_path /demo-assets/* {
        root * /srv/demo-assets
        header X-Content-Type-Options "nosniff"
        file_server
    }
    @api path /api/* /actuator/* /v3/* /swagger-ui /swagger-ui/*
    handle @api {
        reverse_proxy api:8080 {
            header_up -Forwarded
        }
    }
    handle_path /brand/* {
        root * /srv/brand
        file_server
    }
    handle {
        root * /srv/app
        header Referrer-Policy "no-referrer"
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
        try_files {path} /index.html
        file_server
    }

}
